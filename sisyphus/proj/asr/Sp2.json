{"text": " قيد الموت، فتوقف الموت في الأرض كلها، لا الشيخ يموت، ولا الجريح، غضبت الآلهة، وأطلق إله الحرب الموت من قيده، وأخذ سيزف إلى العالم السفلي، لكنه خدعهم مرة أخرى، أقنع آلهة الموت أن يعيدوه إلى الأرض يوما واحدا فقط، فعاد ولم يوجه  وعاش سنوات طويلة يضحك على الموت", "words": [[2.06, 2.66, "قيد", 0.73], [2.66, 3.32, "الموت،", 0.77], [3.32, 4.42, "فتوقف", 1.0], [4.42, 4.84, "الموت", 1.0], [4.84, 4.98, "في", 1.0], [4.98, 5.38, "الأرض", 1.0], [5.38, 6.08, "كلها،", 0.88], [6.08, 6.94, "لا", 0.9], [6.94, 7.32, "الشيخ", 1.0], [7.32, 7.98, "يموت،", 0.96], [7.98, 8.6, "ولا", 1.0], [8.6, 9.32, "الجريح،", 0.99], [9.32, 10.44, "غضبت", 0.92], [10.44, 11.14, "الآلهة،", 0.99], [11.43, 12.69, "وأطلق", 1.0], [12.69, 13.13, "إله", 1.0], [13.13, 13.47, "الحرب", 0.99], [13.47, 14.03, "الموت", 1.0], [14.03, 14.37, "من", 0.49], [14.37, 15.41, "قيده،", 1.0], [15.54, 16.62, "وأخذ", 1.0], [16.62, 17.1, "سيزف", 0.99], [17.1, 17.74, "إلى", 1.0], [17.74, 18.18, "العالم", 1.0], [18.18, 18.78, "السفلي،", 1.0], [19.16, 20.5, "لكنه", 1.0], [20.5, 21.58, "خدعهم", 1.0], [21.58, 21.96, "مرة", 0.99], [21.96, 22.62, "أخرى،", 0.95], [22.75, 23.81, "أقنع", 1.0], [23.81, 24.43, "آلهة", 1.0], [24.43, 24.81, "الموت", 1.0], [24.81, 25.05, "أن", 1.0], [25.05, 25.77, "يعيدوه", 1.0], [25.77, 26.01, "إلى", 1.0], [26.01, 26.41, "الأرض", 1.0], [26.41, 27.21, "يوما", 1.0], [27.21, 27.77, "واحدا", 0.95], [27.77, 28.33, "فقط،", 1.0], [28.33, 28.97, "فعاد", 0.91], [28.97, 29.75, "ولم", 0.85], [29.75, 30.13, "يوجه", 0.8], [30.96, 32.18, "وعاش", 1.0], [32.18, 32.82, "سنوات", 1.0], [32.82, 33.44, "طويلة", 1.0], [33.44, 34.38, "يضحك", 1.0], [34.38, 34.54, "على", 0.99], [34.54, 35.06, "الموت", 1.0]]}